# polestar-exporter configuration
#
# Install as /etc/polestar-exporter/polestar-exporter.env and LOCK IT DOWN —
# it contains your Polestar account password:
#
#   sudo install -d -m 750 /etc/polestar-exporter
#   sudo install -m 600 -o root -g root polestar-exporter.env.example \
#        /etc/polestar-exporter/polestar-exporter.env
#
# systemd reads this file as root, so the service itself can run as an
# unprivileged dynamic user without ever being able to read the file.

# -- Required --
POLESTAR_EMAIL=you@example.com
POLESTAR_PASSWORD=correct-horse-battery-staple

# If you'd rather not keep the password in this file, comment
# POLESTAR_PASSWORD out and use POLESTAR_PASSWORD_FILE instead (that file
# must contain ONLY the password). Pairs nicely with systemd's
# LoadCredential= — see the comment in polestar-exporter.service.
#POLESTAR_PASSWORD_FILE=/etc/polestar-exporter/password

# -- Guest / secondary accounts --
# Vehicle discovery only lists cars the account OWNS. If your car shows as
# "Guest user" on polestar.com, set the VIN(s) here (comma-separated).
#POLESTAR_VINS=LPSVSEDEXML123456

# -- Optional (defaults shown) --
#EXPORTER_PORT=9772
#EXPORTER_ADDRESS=0.0.0.0
#POLL_INTERVAL_SECONDS=300
#EXPORT_LOCATION=true
#EXPORT_WEATHER=true
#LOG_LEVEL=INFO

# TOKEN_CACHE_PATH is set in the unit file to systemd's StateDirectory,
# so OAuth tokens survive restarts without extra setup. Override here if
# you want it somewhere else.
